# Browser-exposed wallet/network config.
# Use NEXT_PUBLIC_ only for values that are safe to appear in the client bundle.
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_SUI_TESTNET_GRPC_URL=https://fullnode.testnet.sui.io:443
NEXT_PUBLIC_SUI_DEVNET_GRPC_URL=https://fullnode.devnet.sui.io:443

# Server-side DeepBook Predict config.
# These are public chain identifiers, but they do not need NEXT_PUBLIC_ because
# only API routes and server-side scripts read them.
PREDICT_SERVER_URL=https://predict-server.testnet.mystenlabs.com
PREDICT_NETWORK=testnet
PREDICT_PACKAGE_ID=0xf5ea2b3749c65d6e56507cc35388719aadb28f9cab873696a2f8687f5c785138
PREDICT_OBJECT_ID=0xc8736204d12f0a7277c86388a68bf8a194b0a14c5538ad13f22cbd8e2a38028a
PREDICT_DUSDC_TYPE=0xe95040085976bfd54a1a07225cd46c8a2b4e8e2b6732f140a0fc49850ba73e1a::dusdc::DUSDC
PREDICT_PLP_COIN_TYPE=0xf5ea2b3749c65d6e56507cc35388719aadb28f9cab873696a2f8687f5c785138::plp::PLP
PREDICT_SOURCE_BRANCH=predict-testnet-4-16

# Gas optimization: keep false for normal trading. Set true only when a demo
# needs an extra on-chain audit event.
PREDICT_ENABLE_ONCHAIN_LOG=false
