{
  "name": "deeppilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "biome:check": "bunx @biomejs/biome check .",
    "biome:write": "bunx @biomejs/biome check --write .",
    "typecheck": "tsc --noEmit",
    "predict:smoke": "bun run scripts/verify-predict.ts",
    "pilot:smoke": "bun run scripts/verify-pilot.ts",
    "telegram:smoke": "bun run scripts/verify-telegram.ts",
    "move:build": "sui move build --path move --build-env testnet",
    "telegram:set-webhook": "bun run scripts/set-telegram-webhook.ts",
    "sui:testnet-key": "bun run scripts/generate-testnet-key.ts"
  },
  "dependencies": {
    "@mysten-incubation/memwal": "^0.0.7",
    "@mysten/dapp-kit-core": "1.3.2",
    "@mysten/dapp-kit-react": "2.0.3",
    "@mysten/seal": "^1.2.1",
    "@mysten/sui": "2.17.0",
    "@mysten/walrus": "^1.2.1",
    "@radix-ui/react-slot": "1.2.5",
    "@radix-ui/react-toast": "1.2.16",
    "@tailwindcss/postcss": "4.3.0",
    "ai": "^6.0.208",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.40.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "1.17.0",
    "next": "16.2.9",
    "postcss": "8.5.15",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.4.1",
    "eslint-config-next": "16.2.9",
    "typescript": "6.0.3"
  }
}
